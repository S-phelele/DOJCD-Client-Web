# Copy to .env (git-ignored). Create React App only exposes variables that start with REACT_APP_
# (the old `API_URL` in the committed .env was never read by anything).
#
# `npm start` always talks to http://localhost:5000/api (see src/services/api.js).
# Production builds read this value; if it is unset they fall back to https://api.malcam.co.za/api.
REACT_APP_API_URL=https://api.malcam.co.za/api
